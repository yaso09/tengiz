+}
+
 func (r *dockerRuntime) RemoveImage(ctx context.Context, imageTag string) error {
 	cmd := exec.CommandContext(ctx, "docker", "rmi", "-f", imageTag)
 	out, err := cmd.CombinedOutput()
 	if err != nil {
 		return fmt.Errorf("docker rmi: %w\n%s", err, string(out))
 	}
 	return nil
 }
 
