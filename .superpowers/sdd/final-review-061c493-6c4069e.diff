+		{ID: "b", Ref: "nginx:latest"},                        // used
+		{ID: "c", Ref: "redis:7"},                             // unused foreign
+		{ID: "d", Ref: "<none>:<none>"},                       // dangling, unused
+	}
+	got := unusedForeignImages(all, []string{"nginx:latest", "someid"})
+	want := []string{"c", "d"}
