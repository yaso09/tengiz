+func unusedForeignImages(all []imageInfo, inUse []string) []imageInfo {
+	used := make(map[string]bool, len(inUse))
+	for _, ref := range inUse {
+		used[ref] = true
+	}
+	var out []imageInfo
+	for _, img := range all {
+		if strings.HasPrefix(img.Ref, "tengiz-apps/") {
+			continue
+		}
+		if used[img.Ref] || used[img.ID] {
+			continue
+		}
+		out = append(out, img)
+	}
+	return out
+}
